# --- Log ---
# DEBUG | INFO | ERROR. INFO pega logs de info e de erro.
LOG_LEVEL=INFO

# --- Modelo (API compatível com OpenAI) ---
# Vazio = detecta em runtime o modelo já carregado no servidor (GET /models),
# sem forçar troca. Nomear um modelo aqui força esse modelo específico,
# pagando reload se for diferente do que já está carregado.
MODEL=
MODEL_BASE_URL=http://localhost:8200/v1
MODEL_API_KEY=not-needed
MODEL_TIMEOUT=120
MODEL_TEMPERATURE=0

# Janela de contexto do modelo, em tokens: precisa bater com o --ctx-size que
# o servidor subiu. E daqui que sai o orcamento do dossie -- estourar nao
# degrada a resposta, o provider recusa a chamada com HTTP 400 e a pesquisa
# inteira se perde. MODEL_RESERVE_TOKENS e o que fica separado para as
# instrucoes, a pergunta e a resposta a ser gerada.
MODEL_CONTEXT_TOKENS=65536
MODEL_RESERVE_TOKENS=4096
# JSON mesclado no payload do /chat/completions. Ex. Qwen3:
# EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
EXTRA_BODY=
# Texto apenso ao final do system prompt em toda chamada. Use para desligar o
# reasoning: num modelo que pensa por padrão ele domina a latência (medido em
# muse-glimmer:30B, gerar 3 linhas de busca: 2767 tokens/39s sem, 271/3s com).
# EXTRA_BODY não resolve — enable_thinking=false é ignorado por esse modelo.
# Ex. muse-glimmer:
# EXTRA_SYSTEM_PROMPT=Reasoning strength: low
EXTRA_SYSTEM_PROMPT=

# --- SearXNG ---
SEARXNG_URL=http://localhost:8886
SEARXNG_MAX_RESULTS=10
SEARXNG_TIMEOUT=10
SEARXNG_LANGUAGE=pt-BR
SEARXNG_CATEGORIES=general,news

# --- Scraper ---
SCRAPER_TIMEOUT=6
# Vazio = lê a página inteira, sem corte.
SCRAPER_LIMIT=

# --- Research (calibragem; ver comentários em config.py) ---
RESEARCH_PAGE_BUDGET=5
RESEARCH_POOL_SIZE=20
RESEARCH_MAX_WAVES=4

# Teto de caracteres por pagina no dossie do research (o read_url ignora e le
# a pagina inteira). Sem teto, uma pagina gigante estoura o contexto do modelo
# e a pesquisa inteira se perde: medido um dossie de 412k chars = 103k tokens
# contra 65k de ctx. Nao aperte muito: dossie pequeno demais piora o resumo.
RESEARCH_PAGE_CHARS=25000

# --- Servidor MCP ---
MCP_NAME=web-search
# stdio | http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Origens liberadas no CORS do transporte --http (separadas por vírgula).
# "*" libera qualquer origem (ok pra uso local, restrinja em produção).
MCP_CORS_ALLOW_ORIGINS=*

# Fuso do host. O carimbo de data já sai com offset explícito; isto é
# conveniência para container, cujo padrão é UTC.
TZ=America/Sao_Paulo

# --- Eval ---
# Vazio = mesmo do MODEL.
EVAL_JUDGE_MODEL=
