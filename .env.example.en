# English version of .env.example: same keys and defaults, comments in
# English. Copy either one to .env — start.sh creates .env from .env.example.

# --- Log ---
# DEBUG | INFO | ERROR. INFO includes info and error logs.
LOG_LEVEL=INFO

# --- Model (OpenAI-compatible API) ---
# Empty = detect at runtime the model already loaded on the server (GET /models),
# without forcing a swap. Naming a model here forces that specific model,
# paying for a reload if it differs from the one already loaded.
MODEL=
MODEL_BASE_URL=http://localhost:8200/v1
MODEL_API_KEY=not-needed
MODEL_TIMEOUT=120
MODEL_TEMPERATURE=0

# Model context window, in tokens: must match the --ctx-size the server was
# started with (llama.cpp/llama-swap expose it and it is detected
# automatically; this is the fallback). The dossier budget comes from here --
# overflowing doesn't degrade the answer, the provider rejects the call with
# HTTP 400 and the whole search is lost. MODEL_RESERVE_TOKENS is what's set
# aside for the instructions, the question and the answer to be generated.
MODEL_CONTEXT_TOKENS=65536
MODEL_RESERVE_TOKENS=4096
# JSON merged into the /chat/completions payload. E.g. Qwen3:
# EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
EXTRA_BODY=
# Text appended to the end of the system prompt on every call. Use it to turn
# reasoning off: on a model that thinks by default it dominates latency
# (measured on muse-glimmer:30B, generating 3 search lines: 2767 tokens/39s
# without, 271/3s with). EXTRA_BODY doesn't solve it -- enable_thinking=false
# is ignored by that model.
# E.g. muse-glimmer:
# EXTRA_SYSTEM_PROMPT=Reasoning strength: low
EXTRA_SYSTEM_PROMPT=

# --- SearXNG ---
SEARXNG_URL=http://localhost:8886
SEARXNG_MAX_RESULTS=10
SEARXNG_TIMEOUT=10
SEARXNG_LANGUAGE=auto
SEARXNG_CATEGORIES=general,news

# --- Tor: link source via Google CSE (plans/tor.md) ---
# Four channels, host:socks_port:control_port. They match the tor-a..tor-d
# services in search-engine/docker-compose.yaml (ports bound to 127.0.0.1).
# The queries of a search rotate across them; a channel blocked by Google
# gets a new circuit and the query retries on the next one immediately.
# SEARCH_BACKEND=searxng goes back to the old path (rollback).
SEARCH_BACKEND=google_tor
TOR_CHANNELS=127.0.0.1:9060:9061,127.0.0.1:9070:9071,127.0.0.1:9080:9081,127.0.0.1:9090:9091
# ControlPort password (NEWNYM). REQUIRED: the tor-a..tor-d containers read
# this same file (env_file: ../.env) and won't start without it. Change the
# value -- the ports only listen on 127.0.0.1, but any local process with the
# password controls tor.
TOR_CONTROL_PASSWORD=troque-esta-senha
# blackle.com's public CX, the same one SearXNG's google cse engine uses.
GOOGLE_CSE_CX=partner-pub-8993703457585266:4862972284
GOOGLE_CSE_HL=pt-BR
GOOGLE_CSE_TIMEOUT=15
# All Tor channels tried were blocked: try the CSE from the machine's IP, then SearXNG.
GOOGLE_CSE_DIRECT_FALLBACK=true
SEARXNG_FALLBACK=true

# --- Scraper ---
SCRAPER_TIMEOUT=6
# Empty = read the whole page, no cut.
SCRAPER_LIMIT=

# --- Research (tuning; see comments in config.py) ---
RESEARCH_PAGE_BUDGET=5
RESEARCH_POOL_SIZE=60
RESEARCH_MAX_WAVES=4
# Max URLs from the same domain among the candidates. 0 = no limit.
RESEARCH_MAX_PER_DOMAIN=2

# Per-page character cap in the research dossier (read_url ignores it and
# reads the whole page). Without a cap, one giant page overflows the model's
# context and the whole search is lost: measured a 412k-char dossier = 103k
# tokens against a 65k ctx. Don't squeeze it too much: a dossier that's too
# small makes the summary worse.
RESEARCH_PAGE_CHARS=25000

# --- MCP server ---
MCP_NAME=web-search
# stdio | http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Origins allowed by CORS on the --http transport (comma-separated).
# "*" allows any origin (fine for local use, restrict it in production).
MCP_CORS_ALLOW_ORIGINS=*

# Host time zone. The date stamp already carries an explicit offset; this is
# a convenience for containers, which default to UTC.
TZ=America/Sao_Paulo

# --- Eval ---
# Empty = same as MODEL.
EVAL_JUDGE_MODEL=
